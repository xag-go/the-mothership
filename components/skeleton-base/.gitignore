# base-folder:start v1
# secrets: never in the base
.env
.env.*
*.pem
*.key
*.p12
secrets/
# caches and generated indexes
.brain/search.db
.brain/backups/
.brain/collector.lock
.brain/watch.lock
.brain/kick
.brain/map.json
.brain/*.tmp
.brain/pycache/
.brain/wiki.lock
.brain/tidy.json
.brain/tidy.log
.brain/.*.tmp*
.base-folder/
__pycache__/
*.pyc
graphify-out/
.obsidian/workspace*.json
.trash/
# big media (keep transcripts in raw/videos/, not the video files)
*.mp4
*.mov
*.mkv
*.avi
*.wav
*.zip
# layout (generated: brain.py layout --print): code, heavy data and tool folders live in the base, never in its git
/projects/*
!/projects/README.md
/data/*
!/data/README.md
/apps/*
!/apps/README.md
/runs/*
!/runs/README.md
/scratch/*
!/scratch/README.md
/backups/*
!/backups/README.md
/engines/**
!/engines/README.md
!/engines/*/
