// Syncthing ignore example for this base (copy the folder with Send Only -> Receive Only).
.obsidian
.git
graphify-out
.brain
.base-folder
// base-folder:start v1
// layout (generated: brain.py layout --print): secrets first (first match wins), then the safe files of
